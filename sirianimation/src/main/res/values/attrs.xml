<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SiriAnimationView">
        <attr name="siri_style" format="enum">
            <enum name="orb" value="0" />
            <enum name="horizontal_band" value="1" />
        </attr>
        <attr name="siri_state" format="enum">
            <enum name="idle" value="0" />
            <enum name="listening" value="1" />
            <enum name="thinking" value="2" />
            <enum name="speaking" value="3" />
        </attr>
        <attr name="siri_preset" format="enum">
            <enum name="classic" value="0" />
            <enum name="vibrant" value="1" />
            <enum name="subtle" value="2" />
            <enum name="custom" value="3" />
        </attr>
        <attr name="siri_intensity" format="float" />
        <attr name="siri_speed" format="float" />
        <attr name="siri_glowIntensity" format="float" />
        <attr name="siri_animated" format="boolean" />
        <attr name="siri_orbSizeFraction" format="float" />
        <attr name="siri_bandHeightFraction" format="float" />
        <attr name="siri_bandVerticalBias" format="float" />
        <attr name="siri_audioReactivity" format="float" />
        <attr name="siri_coreIntensity" format="float" />
        <attr name="siri_glowEnabled" format="boolean" />
        <attr name="siri_glowRadius" format="float" />
    </declare-styleable>
</resources>
